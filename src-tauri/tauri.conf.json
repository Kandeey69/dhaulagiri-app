{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Easysolution",
  "version": "0.1.1",
  "identifier": "com.easysolution.businesssuite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Easysolution",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Easysolution",
    "windows": {
      "wix": {
        "upgradeCode": "31c72a3a-90d5-5bb4-acce-cb6f3852d20e"
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:import-purchases.db", "sqlite:accounts.db", "sqlite:inventorytracked-stock.db"]
    }
  }
}
